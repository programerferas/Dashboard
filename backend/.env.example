# Copy this file to .env and fill in the values. Never commit the real .env.

# ── Database ───────────────────────────────────────────────────────
# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/print_style?schema=public"

# ── Server ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Auth ───────────────────────────────────────────────────────────
# A long random string, at least 16 characters. Use a different one per server.
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=ps_token

# ── Frontend origin allowed to call this API (comma separated) ──────
FRONTEND_URLS=http://localhost:5173

# ── First admin account (used once by `npm run seed`) ──────────────
SEED_ADMIN_EMAIL=
# At least 8 characters. There is no "change password" screen, so choose well.
SEED_ADMIN_PASSWORD=

# ── WhatsApp order notice (Meta Cloud API) ─────────────────────────
# "true" to message the admin when an order is created. Off by default.
WHATSAPP_ENABLED=false
# Meta → WhatsApp → API Setup. Use the test number and temporary token locally,
# a System User token in production.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The admin's number in international format, digits only: 905xxxxxxxxx
WHATSAPP_RECIPIENT=
# Empty: plain text (delivered only within 24h of the admin messaging the business
# number). Set: name of an approved template with 10 body variables.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar
